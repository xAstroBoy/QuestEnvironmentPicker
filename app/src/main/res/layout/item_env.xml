<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@color/md_card_bg"
    android:layout_marginVertical="2dp"
    android:layout_marginHorizontal="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="icon"
            android:layout_marginEnd="12dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lbl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/pkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onSurfaceVariant"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="11sp"
        android:textColor="@color/md_theme_outline"
        android:maxLines="2"
        android:ellipsize="end"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btnChooseZip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/choose_zip"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.TextButton"/>
        <Button
            android:id="@+id/btnApply"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/apply"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.TonalButton"/>
        <Button
            android:id="@+id/btnSetDefault"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Default"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.TextButton"/>
        <Button
            android:id="@+id/btnApplyEnv"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="As Env"
            android:textSize="12sp"
            android:textColor="@color/md_accent_env"
            style="@style/Widget.Material3.Button.TextButton"/>
        <Button
            android:id="@+id/btnUninstall"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Uninstall"
            android:textSize="11sp"
            android:textColor="#FF6B6B"
            style="@style/Widget.Material3.Button.TextButton"/>
        <TextView
            android:id="@+id/state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:textSize="12sp"
            android:textColor="#7FFF7F"
            android:gravity="end"
            android:text=""/>
    </LinearLayout>
</LinearLayout>
